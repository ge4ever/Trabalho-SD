# ==============================================================================
# Exemplo de Variáveis de Ambiente - Trabalho-SD (Topologia 3 VMs)
# ==============================================================================
# Copie este arquivo para .env caso prefira configurar via arquivo:
# cp .env.example .env

# --- Conexão com o Google Cloud SQL (PostgreSQL) ---
# Utilizado pela VM 2 (AccountService) e pela VM 3 (PixService):
DB_HOST=35.202.26.114
DB_PORT=5432
DB_NAME=banco_sd
DB_USER=sd_user
DB_PASSWORD=sd_password

# --- Comunicação gRPC entre as VMs (Rede Interna VPC) ---
# Na VM 1 (API Gateway): IP Interno da VM 2 e da VM 3
ACCOUNT_SERVICE_HOST=10.128.0.3:50052
PIX_SERVICE_HOST=10.128.0.4:50053

# Na VM 3 (PixService): IP Interno da VM 2 para chamadas inter-microsserviços
# ACCOUNT_SERVICE_HOST=10.128.0.3:50052
